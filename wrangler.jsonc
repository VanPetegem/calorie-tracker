{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kcal",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": ["nodejs_als"],
	// The wrapper in worker/index.ts re-exports the SvelteKit Worker's fetch and adds the backup cron.
	"main": "worker/index.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kcal",
			"database_id": "069d8fda-f1a6-4a33-a9a1-96543050b973",
			"migrations_dir": "drizzle"
		}
	],
	// Weekly backups of the app tables (src/lib/server/backup). The bucket must exist before `wrangler deploy`.
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "kcal-backups" }],
	// Monday 03:00 UTC.
	"triggers": { "crons": ["0 3 * * 1"] },
	"ratelimits": [
		// Throttles sign in and sign up attempts per client IP (checked in src/hooks.server.ts).
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		// Outgoing Open Food Facts calls (src/lib/server/off), kept below OFF's own limits of 15 product reads
		// and 10 searches a minute per IP.
		{
			"name": "OFF_PRODUCT_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 12, "period": 60 }
		},
		{
			"name": "OFF_SEARCH_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 8, "period": 60 }
		}
	],
	// Declared so `wrangler types` does not infer the Env type from whatever .env or .dev.vars holds locally.
	"secrets": { "required": ["BETTER_AUTH_SECRET", "OFF_CONTACT_EMAIL"] },
	// Production only. Local dev and e2e override ORIGIN and the OFF hosts (see .env.example and playwright.config.ts).
	"vars": {
		"ORIGIN": "https://kcal.avp.software",
		"OFF_BASE_URL": "https://world.openfoodfacts.org",
		"OFF_SEARCH_URL": "https://search.openfoodfacts.org"
	},
	"routes": [{ "pattern": "kcal.avp.software", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true }
}
