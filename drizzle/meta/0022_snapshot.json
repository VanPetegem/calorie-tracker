          "name": "settings_sex",
          "value": "\"settings\".\"sex\" IS NULL OR \"settings\".\"sex\" IN ('male', 'female')"
        },
        "settings_activity_level": {
          "name": "settings_activity_level",
          "value": "\"settings\".\"activity_level\" IS NULL OR \"settings\".\"activity_level\" IN ('sedentary', 'light', 'moderate', 'active', 'very_active')"
        },
        "settings_height_cm_range": {
          "name": "settings_height_cm_range",
          "value": "\"settings\".\"height_cm\" IS NULL OR \"settings\".\"height_cm\" BETWEEN 100 AND 250"
        },
        "settings_goal_rate": {
          "name": "settings_goal_rate",
          "value": "\"settings\".\"goal_rate_pct\" IN (0.25, 0.35, 0.5)"
        },
        "settings_protein_g_per_kg_range": {
          "name": "settings_protein_g_per_kg_range",
          "value": "\"settings\".\"protein_g_per_kg\" BETWEEN 1.2 AND 3"
        },
        "settings_fat_pct_range": {
          "name": "settings_fat_pct_range",
          "value": "\"settings\".\"fat_pct\" BETWEEN 0.15 AND 0.4"
        },
        "settings_energy_density_range": {
          "name": "settings_energy_density_range",
          "value": "\"settings\".\"energy_density_kcal_per_kg\" BETWEEN 3000 AND 7700"
        }
      }
    },
