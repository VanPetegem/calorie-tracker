{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"]
	},
	"include": [
		"src",
		"worker",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js",
		"playwright.config.ts",
		"drizzle.config.ts",
		"pwa-assets.config.ts",
		"scripts/**/*.ts"
	],
	"exclude": ["src/service-worker"]
}
