# App origin (Better Auth base URL) for `pnpm dev`. Production sets its own in wrangler.jsonc; e2e passes --var.
ORIGIN="http://localhost:5173"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Cloudflare: wrangler reads CLOUDFLARE_API_TOKEN (Account API token) for remote migrations and deploys.
# CI takes the token and account id from GitHub secrets of the same names.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""

# Open Food Facts requires a contact in the User-Agent. Production: wrangler secret put OFF_CONTACT_EMAIL.
OFF_CONTACT_EMAIL=""

# Claude API key for reading nutrition label photos (src/lib/server/label). Production: wrangler secret put ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=""
# Optional: point the Worker at another Open Food Facts host (e2e uses e2e/off-stub.mjs). Defaults are in wrangler.jsonc.
# OFF_BASE_URL="https://world.openfoodfacts.org"
# OFF_SEARCH_URL="https://search.openfoodfacts.org"
