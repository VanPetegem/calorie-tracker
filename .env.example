# App origin (Better Auth base URL) for `pnpm dev`. Production sets its own in wrangler.jsonc; e2e passes --var.
ORIGIN="http://localhost:5173"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Cloudflare: wrangler reads CLOUDFLARE_API_TOKEN (Account API token) for remote migrations and deploys.
# CI takes the token and account id from GitHub secrets of the same names.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""

# Open Food Facts requires a contact in the User-Agent (used from phase 2)
OFF_CONTACT_EMAIL=""
